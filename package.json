{
  "name": "moonage-daydream",
  "displayName": "Moonage Daydream",
  "description": "Database client for SQL Server, MySQL / MariaDB, PostgreSQL, SQLite and MongoDB: run queries from .sql files and view, filter, edit and export the results.",
  "version": "0.5.0",
  "publisher": "exeltarkus",
  "icon": "images/icon.png",
  "license": "GPL-3.0-or-later",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "sql",
    "database",
    "sql server",
    "mssql",
    "mysql",
    "mariadb",
    "postgresql",
    "sqlite",
    "mongodb",
    "query"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onLanguage:sql",
    "onUri",
    "onView:moonageDaydream.explorer",
    "onView:moonageDaydream.sqlFiles"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "moonageDaydream.addConnection",
        "title": "Add Connection",
        "category": "Moonage Daydream",
        "icon": "$(add)"
      },
      {
        "command": "moonageDaydream.importDbcode",
        "title": "Import Connections from DBCode…",
        "category": "Moonage Daydream",
        "icon": "$(cloud-download)"
      },
      {
        "command": "moonageDaydream.autoCommitConfirm",
        "title": "Auto-commit Confirmation…",
        "category": "Moonage Daydream",
        "icon": "$(shield)"
      },
      {
        "command": "moonageDaydream.consulOpenKey",
        "title": "Open Key",
        "category": "Moonage Daydream",
        "icon": "$(go-to-file)"
      },
      {
        "command": "moonageDaydream.consulNewKey",
        "title": "New Key…",
        "category": "Moonage Daydream",
        "icon": "$(add)"
      },
      {
        "command": "moonageDaydream.consulDeleteKey",
        "title": "Delete Key…",
        "category": "Moonage Daydream",
        "icon": "$(trash)"
      },
      {
        "command": "moonageDaydream.consulDashboard",
        "title": "Consul Dashboard",
        "category": "Moonage Daydream",
        "icon": "$(dashboard)"
      },
      {
        "command": "moonageDaydream.editConnection",
        "title": "Edit Connection…",
        "category": "Moonage Daydream",
        "icon": "$(edit)"
      },
      {
        "command": "moonageDaydream.removeConnection",
        "title": "Delete Connection",
        "category": "Moonage Daydream",
        "icon": "$(trash)"
      },
      {
        "command": "moonageDaydream.selectConnection",
        "title": "Select Connection",
        "category": "Moonage Daydream",
        "icon": "$(plug)"
      },
      {
        "command": "moonageDaydream.runQuery",
        "title": "Run Query (selection or statement at cursor)",
        "category": "Moonage Daydream",
        "icon": "$(play)"
      },
      {
        "command": "moonageDaydream.moveResults",
        "title": "Move Results To…",
        "category": "Moonage Daydream",
        "icon": "$(layout)"
      },
      {
        "command": "moonageDaydream.refreshExplorer",
        "title": "Refresh",
        "category": "Moonage Daydream",
        "icon": "$(refresh)"
      },
      {
        "command": "moonageDaydream.selectTop",
        "title": "Select Top 100",
        "category": "Moonage Daydream",
        "icon": "$(play)"
      },
      {
        "command": "moonageDaydream.showDefinition",
        "title": "Show Definition",
        "category": "Moonage Daydream",
        "icon": "$(file-code)"
      },
      {
        "command": "moonageDaydream.editObject",
        "title": "Edit (CREATE OR ALTER script)",
        "category": "Moonage Daydream",
        "icon": "$(edit)"
      },
      {
        "command": "moonageDaydream.runProcedure",
        "title": "Run Procedure…",
        "category": "Moonage Daydream",
        "icon": "$(play)"
      },
      {
        "command": "moonageDaydream.scriptAs",
        "title": "Script as…",
        "category": "Moonage Daydream",
        "icon": "$(file-code)"
      },
      {
        "command": "moonageDaydream.startJob",
        "title": "Start Job",
        "category": "Moonage Daydream",
        "icon": "$(debug-start)"
      },
      {
        "command": "moonageDaydream.stopJob",
        "title": "Stop Job",
        "category": "Moonage Daydream",
        "icon": "$(debug-stop)"
      },
      {
        "command": "moonageDaydream.liveMonitor",
        "title": "Live Monitor (charts)",
        "category": "Moonage Daydream",
        "icon": "$(graph-line)"
      },
      {
        "command": "moonageDaydream.activityMonitor",
        "title": "Activity Monitor (sessions / blocking)",
        "category": "Moonage Daydream",
        "icon": "$(pulse)"
      },
      {
        "command": "moonageDaydream.killSession",
        "title": "Kill Session…",
        "category": "Moonage Daydream",
        "icon": "$(close)"
      },
      {
        "command": "moonageDaydream.serverInfo",
        "title": "Server Info",
        "category": "Moonage Daydream",
        "icon": "$(info)"
      },
      {
        "command": "moonageDaydream.databaseInfo",
        "title": "Database Info",
        "category": "Moonage Daydream",
        "icon": "$(info)"
      },
      {
        "command": "moonageDaydream.backupDatabase",
        "title": "Backup Database (script)…",
        "category": "Moonage Daydream",
        "icon": "$(save)"
      },
      {
        "command": "moonageDaydream.restoreDatabase",
        "title": "Restore Database (script)…",
        "category": "Moonage Daydream",
        "icon": "$(history)"
      },
      {
        "command": "moonageDaydream.setFileConnection",
        "title": "Change Connection for This File",
        "category": "Moonage Daydream"
      },
      {
        "command": "moonageDaydream.setFileDatabase",
        "title": "Change Database for This File",
        "category": "Moonage Daydream"
      },
      {
        "command": "moonageDaydream.cancelQuery",
        "title": "Cancel Query",
        "category": "Moonage Daydream",
        "icon": "$(debug-stop)"
      },
      {
        "command": "moonageDaydream.cancelRunning",
        "title": "Cancel",
        "category": "Moonage Daydream",
        "icon": "$(debug-stop)"
      },
      {
        "command": "moonageDaydream.cancelAllQueries",
        "title": "Cancel All Running Queries",
        "category": "Moonage Daydream",
        "icon": "$(stop-circle)"
      },
      {
        "command": "moonageDaydream.openHistory",
        "title": "Open in Editor",
        "category": "Moonage Daydream",
        "icon": "$(go-to-file)"
      },
      {
        "command": "moonageDaydream.runHistory",
        "title": "Run Again",
        "category": "Moonage Daydream",
        "icon": "$(play)"
      },
      {
        "command": "moonageDaydream.copyHistory",
        "title": "Copy SQL",
        "category": "Moonage Daydream",
        "icon": "$(copy)"
      },
      {
        "command": "moonageDaydream.removeHistory",
        "title": "Remove from History",
        "category": "Moonage Daydream",
        "icon": "$(close)"
      },
      {
        "command": "moonageDaydream.clearHistory",
        "title": "Clear History",
        "category": "Moonage Daydream",
        "icon": "$(clear-all)"
      },
      {
        "command": "moonageDaydream.sqlFilesFlat",
        "title": "Show SQL Files as List",
        "category": "Moonage Daydream",
        "icon": "$(list-flat)"
      },
      {
        "command": "moonageDaydream.sqlFilesTree",
        "title": "Show SQL Files as Folders",
        "category": "Moonage Daydream",
        "icon": "$(list-tree)"
      },
      {
        "command": "moonageDaydream.refreshSqlFiles",
        "title": "Refresh SQL Files",
        "category": "Moonage Daydream",
        "icon": "$(refresh)"
      },
      {
        "command": "moonageDaydream.newSqlFile",
        "title": "New SQL File",
        "category": "Moonage Daydream",
        "icon": "$(new-file)"
      },
      {
        "command": "moonageDaydream.newQueryForDb",
        "title": "New SQL File",
        "category": "Moonage Daydream",
        "icon": "$(new-file)"
      },
      {
        "command": "moonageDaydream.formatSql",
        "title": "Format SQL (Moonage)",
        "category": "Moonage Daydream"
      },
      {
        "command": "moonageDaydream.runStatement",
        "title": "Execute Statement",
        "category": "Moonage Daydream",
        "icon": "$(play)"
      },
      {
        "command": "moonageDaydream.explain",
        "title": "Explain (estimated plan)",
        "category": "Moonage Daydream",
        "icon": "$(list-tree)"
      },
      {
        "command": "moonageDaydream.analyze",
        "title": "Analyze (actual plan, SELECT only)",
        "category": "Moonage Daydream",
        "icon": "$(pulse)"
      },
      {
        "command": "moonageDaydream.pinResults",
        "title": "Pin Results (keep in its own tab, side by side)",
        "category": "Moonage Daydream",
        "icon": "$(pinned)"
      },
      {
        "command": "moonageDaydream.toggleTransactionMode",
        "title": "Toggle Transaction Mode (Auto-commit / Manual)",
        "category": "Moonage Daydream",
        "icon": "$(lock)"
      },
      {
        "command": "moonageDaydream.commitTransaction",
        "title": "Commit Transaction",
        "category": "Moonage Daydream",
        "icon": "$(check)"
      },
      {
        "command": "moonageDaydream.rollbackTransaction",
        "title": "Rollback Transaction",
        "category": "Moonage Daydream",
        "icon": "$(discard)"
      },
      {
        "command": "moonageDaydream.renameSqlFile",
        "title": "Rename…",
        "category": "Moonage Daydream",
        "icon": "$(edit)"
      },
      {
        "command": "moonageDaydream.duplicateSqlFile",
        "title": "Duplicate…",
        "category": "Moonage Daydream",
        "icon": "$(copy)"
      },
      {
        "command": "moonageDaydream.deleteSqlFile",
        "title": "Delete",
        "category": "Moonage Daydream",
        "icon": "$(trash)"
      },
      {
        "command": "moonageDaydream.copySqlFilePath",
        "title": "Copy Path",
        "category": "Moonage Daydream"
      },
      {
        "command": "moonageDaydream.copySqlFileRelativePath",
        "title": "Copy Relative Path",
        "category": "Moonage Daydream"
      },
      {
        "command": "moonageDaydream.openSqlFileToSide",
        "title": "Open to the Side",
        "category": "Moonage Daydream",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "moonageDaydream.revealSqlFile",
        "title": "Reveal in Explorer View",
        "category": "Moonage Daydream"
      },
      {
        "command": "moonageDaydream.moveConnectionToGroup",
        "title": "Move to Group…",
        "category": "Moonage Daydream",
        "icon": "$(folder-library)"
      },
      {
        "command": "moonageDaydream.renameGroup",
        "title": "Rename Group…",
        "category": "Moonage Daydream",
        "icon": "$(edit)"
      },
      {
        "command": "moonageDaydream.renameConnection",
        "title": "Rename…",
        "category": "Moonage Daydream",
        "icon": "$(pencil)"
      },
      {
        "command": "moonageDaydream.changeConnectionColor",
        "title": "Change Color…",
        "category": "Moonage Daydream",
        "icon": "$(symbol-color)"
      }
    ],
    "keybindings": [
      {
        "command": "moonageDaydream.runQuery",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "editorTextFocus && editorLangId == sql"
      },
      {
        "command": "moonageDaydream.formatSql",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f",
        "when": "editorTextFocus && editorLangId == sql && !editorReadonly"
      },
      {
        "command": "moonageDaydream.formatSql",
        "key": "shift+alt+f",
        "mac": "shift+alt+f",
        "when": "editorTextFocus && editorLangId == sql && !editorReadonly && moonageDaydream.ownFormatter"
      },
      {
        "command": "moonageDaydream.runQuery",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == sql && moonageDaydream.ownRunner"
      },
      {
        "command": "moonageDaydream.renameSqlFile",
        "key": "f2",
        "mac": "enter",
        "when": "focusedView == moonageDaydream.sqlFiles"
      },
      {
        "command": "moonageDaydream.deleteSqlFile",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == moonageDaydream.sqlFiles"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "moonageDaydream.runQuery",
          "when": "editorLangId == sql",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "moonageDaydream.moveResults",
          "when": "view == moonageDaydream.results",
          "group": "navigation"
        },
        {
          "command": "moonageDaydream.addConnection",
          "when": "view == moonageDaydream.explorer",
          "group": "navigation@1"
        },
        {
          "command": "moonageDaydream.importDbcode",
          "when": "view == moonageDaydream.explorer",
          "group": "import@1"
        },
        {
          "command": "moonageDaydream.refreshExplorer",
          "when": "view == moonageDaydream.explorer",
          "group": "navigation@2"
        },
        {
          "command": "moonageDaydream.cancelAllQueries",
          "when": "view == moonageDaydream.running",
          "group": "navigation"
        },
        {
          "command": "moonageDaydream.clearHistory",
          "when": "view == moonageDaydream.history",
          "group": "navigation"
        },
        {
          "command": "moonageDaydream.newSqlFile",
          "when": "view == moonageDaydream.sqlFiles",
          "group": "navigation@0"
        },
        {
          "command": "moonageDaydream.sqlFilesFlat",
          "when": "view == moonageDaydream.sqlFiles && !moonageDaydream.sqlFilesFlat",
          "group": "navigation@1"
        },
        {
          "command": "moonageDaydream.sqlFilesTree",
          "when": "view == moonageDaydream.sqlFiles && moonageDaydream.sqlFilesFlat",
          "group": "navigation@1"
        },
        {
          "command": "moonageDaydream.refreshSqlFiles",
          "when": "view == moonageDaydream.sqlFiles",
          "group": "navigation@2"
        },
        {
          "command": "moonageDaydream.pinResults",
          "when": "view == moonageDaydream.results",
          "group": "navigation@0"
        }
      ],
      "view/item/context": [
        {
          "command": "moonageDaydream.selectTop",
          "when": "view == moonageDaydream.explorer && viewItem =~ /^(table|view)(\\.def)?(\\.ms)?$/",
          "group": "inline"
        },
        {
          "command": "moonageDaydream.selectTop",
          "when": "view == moonageDaydream.explorer && viewItem =~ /^(table|view)(\\.def)?(\\.ms)?$/",
          "group": "1_query"
        },
        {
          "command": "moonageDaydream.runProcedure",
          "when": "view == moonageDaydream.explorer && viewItem =~ /^(procedure|function)\\.def(\\.ms)?$/",
          "group": "inline"
        },
        {
          "command": "moonageDaydream.runProcedure",
          "when": "view == moonageDaydream.explorer && viewItem =~ /^(procedure|function)\\.def(\\.ms)?$/",
          "group": "1_run@1"
        },
        {
          "command": "moonageDaydream.showDefinition",
          "when": "view == moonageDaydream.explorer && viewItem =~ /^(view|procedure|function|trigger)\\.def(\\.ms)?$/",
          "group": "2_script@1"
        },
        {
          "command": "moonageDaydream.editObject",
          "when": "view == moonageDaydream.explorer && viewItem =~ /^(view|procedure|function|trigger)\\.def(\\.ms)?$/",
          "group": "2_script@2"
        },
        {
          "command": "moonageDaydream.selectConnection",
          "when": "view == moonageDaydream.explorer && viewItem =~ /^conn(\\.\\w+)?$/",
          "group": "inline"
        },
        {
          "command": "moonageDaydream.selectConnection",
          "when": "view == moonageDaydream.explorer && viewItem =~ /^conn(\\.\\w+)?$/",
          "group": "1_conn@1"
        },
        {
          "command": "moonageDaydream.editConnection",
          "when": "view == moonageDaydream.explorer && viewItem =~ /^conn(\\.\\w+)?$/",
          "group": "2_edit@1"
        },
        {
          "command": "moonageDaydream.removeConnection",
          "when": "view == moonageDaydream.explorer && viewItem =~ /^conn(\\.\\w+)?$/",
          "group": "9_delete@1"
        },
        {
          "command": "moonageDaydream.refreshExplorer",
          "when": "view == moonageDaydream.explorer && viewItem =~ /^(conn|db)(\\.\\w+)?$/",
          "group": "2_refresh"
        },
        {
          "command": "moonageDaydream.cancelRunning",
          "when": "view == moonageDaydream.running && viewItem == running",
          "group": "inline"
        },
        {
          "command": "moonageDaydream.cancelRunning",
          "when": "view == moonageDaydream.running && viewItem == running",
          "group": "1"
        },
        {
          "command": "moonageDaydream.runHistory",
          "when": "view == moonageDaydream.history && viewItem == history",
          "group": "inline@1"
        },
        {
          "command": "moonageDaydream.copyHistory",
          "when": "view == moonageDaydream.history && viewItem == history",
          "group": "inline@2"
        },
        {
          "command": "moonageDaydream.openHistory",
          "when": "view == moonageDaydream.history && viewItem == history",
          "group": "1@1"
        },
        {
          "command": "moonageDaydream.runHistory",
          "when": "view == moonageDaydream.history && viewItem == history",
          "group": "1@2"
        },
        {
          "command": "moonageDaydream.copyHistory",
          "when": "view == moonageDaydream.history && viewItem == history",
          "group": "1@3"
        },
        {
          "command": "moonageDaydream.removeHistory",
          "when": "view == moonageDaydream.history && viewItem == history",
          "group": "2"
        },
        {
          "command": "moonageDaydream.newSqlFile",
          "when": "view == moonageDaydream.sqlFiles && viewItem =~ /^sqlFolder/",
          "group": "inline"
        },
        {
          "command": "moonageDaydream.newSqlFile",
          "when": "view == moonageDaydream.sqlFiles && viewItem =~ /^sqlFolder/",
          "group": "1_new"
        },
        {
          "command": "moonageDaydream.newQueryForDb",
          "when": "view == moonageDaydream.explorer && viewItem =~ /^db(\\.\\w+)?$/",
          "group": "1_query"
        },
        {
          "command": "moonageDaydream.newQueryForDb",
          "when": "view == moonageDaydream.explorer && viewItem =~ /^db(\\.\\w+)?$/",
          "group": "inline"
        },
        {
          "command": "moonageDaydream.openSqlFileToSide",
          "when": "view == moonageDaydream.sqlFiles && viewItem == sqlFile",
          "group": "1_open@1"
        },
        {
          "command": "moonageDaydream.revealSqlFile",
          "when": "view == moonageDaydream.sqlFiles && viewItem =~ /^sql/",
          "group": "1_open@2"
        },
        {
          "command": "moonageDaydream.duplicateSqlFile",
          "when": "view == moonageDaydream.sqlFiles && viewItem == sqlFile",
          "group": "3_edit@1"
        },
        {
          "command": "moonageDaydream.renameSqlFile",
          "when": "view == moonageDaydream.sqlFiles && viewItem =~ /^sql(File|Folder)$/",
          "group": "3_edit@2"
        },
        {
          "command": "moonageDaydream.deleteSqlFile",
          "when": "view == moonageDaydream.sqlFiles && viewItem =~ /^sql(File|Folder)$/",
          "group": "3_edit@3"
        },
        {
          "command": "moonageDaydream.copySqlFilePath",
          "when": "view == moonageDaydream.sqlFiles && viewItem =~ /^sql/",
          "group": "4_copy@1"
        },
        {
          "command": "moonageDaydream.copySqlFileRelativePath",
          "when": "view == moonageDaydream.sqlFiles && viewItem =~ /^sql/",
          "group": "4_copy@2"
        },
        {
          "command": "moonageDaydream.moveConnectionToGroup",
          "when": "view == moonageDaydream.explorer && viewItem =~ /^conn(\\.\\w+)?$/",
          "group": "2_edit@4"
        },
        {
          "command": "moonageDaydream.renameGroup",
          "when": "view == moonageDaydream.explorer && viewItem == group",
          "group": "1_group"
        },
        {
          "command": "moonageDaydream.addConnection",
          "when": "view == moonageDaydream.explorer && viewItem == group",
          "group": "inline"
        },
        {
          "command": "moonageDaydream.addConnection",
          "when": "view == moonageDaydream.explorer && viewItem == group",
          "group": "0_add"
        },
        {
          "command": "moonageDaydream.renameConnection",
          "when": "view == moonageDaydream.explorer && viewItem =~ /^conn(\\.\\w+)?$/",
          "group": "2_edit@2"
        },
        {
          "command": "moonageDaydream.changeConnectionColor",
          "when": "view == moonageDaydream.explorer && viewItem =~ /^conn(\\.\\w+)?$/",
          "group": "2_edit@3"
        },
        {
          "command": "moonageDaydream.editConnection",
          "when": "view == moonageDaydream.explorer && viewItem =~ /^conn(\\.\\w+)?$/",
          "group": "inline@2"
        },
        {
          "command": "moonageDaydream.scriptAs",
          "when": "view == moonageDaydream.explorer && viewItem =~ /^(table|view|procedure|function|trigger)\\.def\\.ms$/",
          "group": "2_script@3"
        },
        {
          "command": "moonageDaydream.startJob",
          "when": "view == moonageDaydream.explorer && viewItem == job",
          "group": "1_job@1"
        },
        {
          "command": "moonageDaydream.stopJob",
          "when": "view == moonageDaydream.explorer && viewItem == job",
          "group": "1_job@2"
        },
        {
          "command": "moonageDaydream.activityMonitor",
          "when": "view == moonageDaydream.explorer && viewItem == conn.mssql",
          "group": "3_server@1"
        },
        {
          "command": "moonageDaydream.killSession",
          "when": "view == moonageDaydream.explorer && viewItem == conn.mssql",
          "group": "3_server@2"
        },
        {
          "command": "moonageDaydream.serverInfo",
          "when": "view == moonageDaydream.explorer && viewItem == conn.mssql",
          "group": "3_server@3"
        },
        {
          "command": "moonageDaydream.databaseInfo",
          "when": "view == moonageDaydream.explorer && viewItem == db.mssql",
          "group": "3_db@1"
        },
        {
          "command": "moonageDaydream.backupDatabase",
          "when": "view == moonageDaydream.explorer && viewItem == db.mssql",
          "group": "3_db@2"
        },
        {
          "command": "moonageDaydream.restoreDatabase",
          "when": "view == moonageDaydream.explorer && viewItem == db.mssql",
          "group": "3_db@3"
        },
        {
          "command": "moonageDaydream.liveMonitor",
          "when": "view == moonageDaydream.explorer && viewItem =~ /^conn\\.(mssql|live)$/",
          "group": "3_server@0"
        },
        {
          "command": "moonageDaydream.liveMonitor",
          "when": "view == moonageDaydream.explorer && viewItem =~ /^db\\.(mssql|live)$/",
          "group": "3_db@0"
        },
        {
          "command": "moonageDaydream.autoCommitConfirm",
          "when": "view == moonageDaydream.explorer && viewItem == group",
          "group": "4_safety@1"
        },
        {
          "command": "moonageDaydream.autoCommitConfirm",
          "when": "view == moonageDaydream.explorer && viewItem =~ /^conn(\\.\\w+)?$/",
          "group": "4_safety@1"
        },
        {
          "command": "moonageDaydream.consulNewKey",
          "when": "view == moonageDaydream.explorer && viewItem =~ /^(conn\\.consul|kvFolder)$/",
          "group": "inline"
        },
        {
          "command": "moonageDaydream.consulNewKey",
          "when": "view == moonageDaydream.explorer && viewItem =~ /^(conn\\.consul|kvFolder)$/",
          "group": "1_kv@1"
        },
        {
          "command": "moonageDaydream.consulOpenKey",
          "when": "view == moonageDaydream.explorer && viewItem == kvKey",
          "group": "1_kv@1"
        },
        {
          "command": "moonageDaydream.consulDeleteKey",
          "when": "view == moonageDaydream.explorer && viewItem =~ /^kv(Key|Folder)$/",
          "group": "1_kv@9"
        },
        {
          "command": "moonageDaydream.consulDashboard",
          "when": "view == moonageDaydream.explorer && viewItem == conn.consul",
          "group": "3_server@0"
        }
      ],
      "commandPalette": [
        {
          "command": "moonageDaydream.cancelRunning",
          "when": "false"
        },
        {
          "command": "moonageDaydream.openHistory",
          "when": "false"
        },
        {
          "command": "moonageDaydream.runHistory",
          "when": "false"
        },
        {
          "command": "moonageDaydream.copyHistory",
          "when": "false"
        },
        {
          "command": "moonageDaydream.removeHistory",
          "when": "false"
        },
        {
          "command": "moonageDaydream.selectTop",
          "when": "false"
        },
        {
          "command": "moonageDaydream.newQueryForDb",
          "when": "false"
        },
        {
          "command": "moonageDaydream.runStatement",
          "when": "false"
        },
        {
          "command": "moonageDaydream.explain",
          "when": "editorLangId == sql"
        },
        {
          "command": "moonageDaydream.analyze",
          "when": "editorLangId == sql"
        },
        {
          "command": "moonageDaydream.renameSqlFile",
          "when": "false"
        },
        {
          "command": "moonageDaydream.duplicateSqlFile",
          "when": "false"
        },
        {
          "command": "moonageDaydream.deleteSqlFile",
          "when": "false"
        },
        {
          "command": "moonageDaydream.copySqlFilePath",
          "when": "false"
        },
        {
          "command": "moonageDaydream.copySqlFileRelativePath",
          "when": "false"
        },
        {
          "command": "moonageDaydream.openSqlFileToSide",
          "when": "false"
        },
        {
          "command": "moonageDaydream.revealSqlFile",
          "when": "false"
        },
        {
          "command": "moonageDaydream.moveConnectionToGroup",
          "when": "false"
        },
        {
          "command": "moonageDaydream.renameGroup",
          "when": "false"
        },
        {
          "command": "moonageDaydream.renameConnection",
          "when": "false"
        },
        {
          "command": "moonageDaydream.changeConnectionColor",
          "when": "false"
        },
        {
          "command": "moonageDaydream.consulOpenKey",
          "when": "false"
        },
        {
          "command": "moonageDaydream.consulDeleteKey",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "moonageDaydream.formatSql",
          "when": "editorLangId == sql && !editorReadonly",
          "group": "1_modification@1"
        },
        {
          "command": "moonageDaydream.explain",
          "when": "editorLangId == sql",
          "group": "navigation@2"
        },
        {
          "command": "moonageDaydream.analyze",
          "when": "editorLangId == sql",
          "group": "navigation@3"
        }
      ]
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "moonageDaydream",
          "title": "Moonage Daydream",
          "icon": "media/results.svg"
        }
      ],
      "activitybar": [
        {
          "id": "moonageDaydreamExplorer",
          "title": "Moonage Daydream",
          "icon": "media/results.svg"
        }
      ]
    },
    "views": {
      "moonageDaydream": [
        {
          "type": "webview",
          "id": "moonageDaydream.results",
          "name": "Results"
        }
      ],
      "moonageDaydreamExplorer": [
        {
          "id": "moonageDaydream.explorer",
          "name": "Connections"
        },
        {
          "id": "moonageDaydream.sqlFiles",
          "name": "SQL Files"
        },
        {
          "id": "moonageDaydream.running",
          "name": "Running Queries"
        },
        {
          "id": "moonageDaydream.history",
          "name": "Query History"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "moonageDaydream.explorer",
        "contents": "No connection yet.\n[Add Connection](command:moonageDaydream.addConnection)"
      },
      {
        "view": "moonageDaydream.running",
        "contents": "No query is running."
      },
      {
        "view": "moonageDaydream.history",
        "contents": "No query yet. Run a query (Ctrl+Alt+Enter) and it shows up here."
      },
      {
        "view": "moonageDaydream.sqlFiles",
        "contents": "No .sql files in this workspace.\n[New SQL File](command:moonageDaydream.newSqlFile)"
      }
    ],
    "configuration": {
      "title": "Moonage Daydream",
      "properties": {
        "moonageDaydream.format.keywordCase": {
          "type": "string",
          "enum": [
            "upper",
            "lower",
            "preserve"
          ],
          "default": "upper",
          "description": "Keyword case when formatting SQL (Format Document / Shift+Alt+F)."
        },
        "moonageDaydream.format.leadingComma": {
          "type": "boolean",
          "default": true,
          "description": "Put commas at the start of the line (`    , column`) when formatting SQL."
        },
        "moonageDaydream.query.autoLimit": {
          "type": "number",
          "default": 100,
          "minimum": 0,
          "description": "Auto limit for a single SELECT without TOP / OFFSET FETCH / INTO: only the first N rows are fetched and the query is stopped on the server. 0 = off."
        },
        "moonageDaydream.format.semicolonNewline": {
          "type": "boolean",
          "default": true,
          "description": "Put the semicolon that ends a statement on its own line when formatting SQL."
        },
        "moonageDaydream.lint.semicolon": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "off"
          ],
          "default": "error",
          "description": "Mark SQL statements that are not terminated with ; (before GO / end of file)."
        },
        "moonageDaydream.transaction.mode": {
          "type": "string",
          "enum": [
            "auto",
            "manual"
          ],
          "default": "auto",
          "description": "Default transaction mode for SQL files. manual: queries run in an open transaction until you Commit / Rollback (CodeLens or status bar)."
        }
      }
    },
    "configurationDefaults": {
      "[sql]": {
        "editor.defaultFormatter": "exeltarkus.moonage-daydream"
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run bundle",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "dev": "npm run compile && bash scripts/dev.sh",
    "test:real": "npm run compile && bash scripts/real-test.sh",
    "test:servers": "npm run compile && bash scripts/test-servers.sh",
    "test:servers-ui": "npm run compile && bash scripts/test-servers.sh ui",
    "test": "npm run compile && node --test out/test/*.test.js",
    "package": "vsce package --skip-license",
    "install:local": "node scripts/install-local.js",
    "bundle": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --external:./test/real --format=cjs --platform=node --target=node18 --minify",
    "deploy": "node scripts/deploy.js"
  },
  "dependencies": {
    "mongodb": "^6.21.0",
