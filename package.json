        "contents": "No connection yet.\n[Add Connection](command:moonageDaydream.addConnection)",
        "when": "moonageDaydream.loaded.explorer"
      },
      {
        "view": "moonageDaydream.sqlFiles",
        "contents": "Scanning the workspace for .sql files…",
        "when": "moonageDaydream.loaded.sqlFiles && moonageDaydream.sqlFilesScanning"
      },
      {
        "view": "moonageDaydream.sqlFiles",
        "contents": "No .sql files in this workspace.\n[New SQL File](command:moonageDaydream.newSqlFile)",
        "when": "moonageDaydream.loaded.sqlFiles && !moonageDaydream.sqlFilesScanning"
      },
      {
        "view": "moonageDaydream.openSql",
        "contents": "No SQL tab is open.\n[New SQL File](command:moonageDaydream.openNewFile)",
        "when": "moonageDaydream.loaded.openSql"
      }
    ],
    "configuration": {
      "title": "Moonage Daydream",
      "properties": {
        "moonageDaydream.format.keywordCase": {
          "type": "string",
          "enum": [
            "upper",
            "lower",
            "preserve"
          ],
          "default": "upper",
          "description": "Keyword case when formatting SQL (Format Document / Shift+Alt+F)."
        },
        "moonageDaydream.format.leadingComma": {
          "type": "boolean",
          "default": true,
          "description": "Put commas at the start of the line (`    , column`) when formatting SQL."
        },
        "moonageDaydream.query.autoLimit": {
          "type": "number",
          "default": 100,
          "minimum": 0,
          "description": "Auto limit for a single SELECT without TOP / OFFSET FETCH / INTO: only the first N rows are fetched and the query is stopped on the server. 0 = off."
        },
        "moonageDaydream.format.semicolonNewline": {
          "type": "boolean",
          "default": true,
          "description": "Put the semicolon that ends a statement on its own line when formatting SQL."
        },
        "moonageDaydream.lint.semicolon": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "off"
          ],
          "default": "error",
          "description": "Mark SQL statements that are not terminated with ; (before GO / end of file)."
        },
        "moonageDaydream.lint.syntax": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "off"
          ],
          "default": "warning",
          "description": "Mark SQL syntax errors in SELECT / INSERT / UPDATE / DELETE / WITH statements, checked offline with the dialect of the file's connection (other statements are not checked)."
        },
        "moonageDaydream.transaction.mode": {
          "type": "string",
          "enum": [
            "auto",
            "manual"
          ],
          "default": "auto",
          "description": "Default transaction mode for SQL files. manual: queries run in an open transaction until you Commit / Rollback (CodeLens or status bar)."
        },
        "moonageDaydream.connection.idleDisconnectMinutes": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Disconnect a connection automatically after it has not been used for this many minutes (no running query, open transaction or monitor). 0 = never."
        },
        "moonageDaydream.grid.copyFormat": {
          "type": "string",
          "enum": [
            "jsonPretty",
            "json",
            "tsv",
            "csv",
            "markdown"
          ],
          "enumDescriptions": [
            "JSON array of objects, indented",
            "JSON array of objects on one line",
            "Tab separated rows without header (paste into a spreadsheet)",
            "CSV with header",
            "Markdown table"
          ],
          "default": "jsonPretty",
          "description": "Format of the selected rows copied with Ctrl+C / Cmd+C in the result grid."
        },
        "moonageDaydream.grid.maxCachedRows": {
          "type": "number",
          "default": 5000000,
          "minimum": 1,
          "maximum": 5000000,
          "description": "Load all: maximum rows kept in the result cache per result (at most 5,000,000). When reached, the query is cancelled on the server and the result is marked partial."
        },
        "moonageDaydream.grid.cacheMemoryMB": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "maximum": 100,
          "description": "Load all: RAM used by the result cache per result in MB (at most 100). Rows beyond it are written to .moonage-cache in the workspace folder (ignored by git)."
        }
      }
    },
    "configurationDefaults": {
      "[sql]": {
        "editor.defaultFormatter": "exeltarkus.moonage-daydream"
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run bundle",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "dev": "npm run compile && bash scripts/dev.sh",
    "test:real": "npm run compile && bash scripts/real-test.sh",
    "test:servers": "npm run compile && bash scripts/test-servers.sh",
    "test:servers-ui": "npm run compile && bash scripts/test-servers.sh ui",
    "test": "npm run compile && node --test out/test/*.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "git config core.hooksPath .githooks || true",
    "package": "vsce package --skip-license",
    "install:local": "node scripts/install-local.js",
    "bundle": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --external:./test/real --format=cjs --platform=node --target=node18 --minify",
    "deploy": "bash scripts/deploy-v2.sh",
    "deploy:token": "node scripts/deploy.js"
  },
