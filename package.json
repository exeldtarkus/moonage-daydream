{
  "name": "moonage-daydream",
  "displayName": "Moonage Daydream",
  "description": "Database client for SQL Server, MySQL / MariaDB, PostgreSQL, SQLite and MongoDB: run queries from .sql files and view, filter, edit and export the results.",
  "version": "1.2.2",
  "publisher": "exeltarkus",
  "icon": "images/icon.png",
  "license": "GPL-3.0-or-later",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "sql",
    "database",
    "sql server",
    "mssql",
    "mysql",
    "mariadb",
    "postgresql",
    "sqlite",
    "mongodb",
    "query"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onLanguage:sql",
    "onUri",
    "onView:moonageDaydream.explorer",
    "onView:moonageDaydream.openSql",
    "onView:moonageDaydream.sqlFiles"
  ],
  "main": "./out/extension.js",
  "contributes": {
