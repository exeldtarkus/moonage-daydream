    "keybindings": [
      {
        "command": "moonageDaydream.runQuery",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "editorTextFocus && editorLangId == sql"
      },
      {
        "command": "moonageDaydream.formatSql",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f",
        "when": "editorTextFocus && editorLangId == sql && !editorReadonly"
      },
      {
        "command": "moonageDaydream.formatSql",
        "key": "shift+alt+f",
        "mac": "shift+alt+f",
        "when": "editorTextFocus && editorLangId == sql && !editorReadonly && moonageDaydream.ownFormatter"
      },
      {
        "command": "moonageDaydream.runQuery",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == sql && moonageDaydream.ownRunner"
      },
      {
        "command": "moonageDaydream.renameSqlFile",
        "key": "f2",
        "mac": "enter",
        "when": "focusedView == moonageDaydream.sqlFiles"
      },
      {
        "command": "moonageDaydream.deleteSqlFile",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == moonageDaydream.sqlFiles"
      },
      {
        "command": "moonageDaydream.filterNode",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f",
        "when": "focusedView == moonageDaydream.explorer"
      },
      {
        "command": "moonageDaydream.findObject",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "moonageDaydream.runQuery",
          "when": "editorLangId == sql",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "moonageDaydream.moveResults",
          "when": "view == moonageDaydream.results",
          "group": "navigation"
        },
        {
          "command": "moonageDaydream.addConnection",
          "when": "view == moonageDaydream.explorer",
          "group": "navigation@1"
        },
        {
          "command": "moonageDaydream.importDbcode",
          "when": "view == moonageDaydream.explorer",
          "group": "import@1"
        },
        {
          "command": "moonageDaydream.whatsNew",
          "when": "view == moonageDaydream.explorer",
          "group": "help@1"
        },
        {
          "command": "moonageDaydream.findObject",
          "when": "view == moonageDaydream.explorer",
          "group": "navigation@1"
        },
        {
          "command": "moonageDaydream.clearFilters",
          "when": "view == moonageDaydream.explorer && moonageDaydream.explorerFiltered",
          "group": "navigation@2"
        },
        {
          "command": "moonageDaydream.refreshExplorer",
          "when": "view == moonageDaydream.explorer",
          "group": "navigation@2"
        },
        {
          "command": "moonageDaydream.newSqlFile",
          "when": "view == moonageDaydream.sqlFiles",
          "group": "navigation@0"
        },
        {
          "command": "moonageDaydream.sqlFilesFlat",
          "when": "view == moonageDaydream.sqlFiles && !moonageDaydream.sqlFilesFlat",
          "group": "navigation@1"
        },
        {
          "command": "moonageDaydream.sqlFilesTree",
          "when": "view == moonageDaydream.sqlFiles && moonageDaydream.sqlFilesFlat",
          "group": "navigation@1"
        },
        {
          "command": "moonageDaydream.refreshSqlFiles",
          "when": "view == moonageDaydream.sqlFiles",
          "group": "navigation@2"
        },
        {
          "command": "moonageDaydream.pinResults",
          "when": "view == moonageDaydream.results",
          "group": "navigation@0"
        },
        {
          "command": "moonageDaydream.openNewFile",
          "when": "view == moonageDaydream.openSql",
          "group": "navigation@1"
        },
        {
          "command": "moonageDaydream.openSaveAll",
          "when": "view == moonageDaydream.openSql",
          "group": "navigation@2"
        },
        {
          "command": "moonageDaydream.openCloseAll",
          "when": "view == moonageDaydream.openSql",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "moonageDaydream.openPin",
          "when": "view == moonageDaydream.openSql && viewItem =~ /^openSql(File|Untitled)$/",
          "group": "inline@1"
        },
        {
          "command": "moonageDaydream.openUnpin",
          "when": "view == moonageDaydream.openSql && viewItem =~ /\\.pinned$/",
          "group": "inline@1"
        },
        {
          "command": "moonageDaydream.openPin",
          "when": "view == moonageDaydream.openSql && viewItem =~ /^openSql(File|Untitled)$/",
          "group": "0_pin"
        },
        {
          "command": "moonageDaydream.openUnpin",
          "when": "view == moonageDaydream.openSql && viewItem =~ /\\.pinned$/",
          "group": "0_pin"
        },
        {
          "command": "moonageDaydream.openClose",
          "when": "view == moonageDaydream.openSql",
          "group": "inline@2"
        },
        {
          "command": "moonageDaydream.openClose",
          "when": "view == moonageDaydream.openSql",
          "group": "1_close"
        },
        {
          "command": "moonageDaydream.filterNode",
          "when": "view == moonageDaydream.explorer && viewItem =~ /^(conn\\.(?!consul)|db|folder\\.|ms\\.)/",
          "group": "inline@8"
        },
        {
          "command": "moonageDaydream.findObject",
          "when": "view == moonageDaydream.explorer && viewItem =~ /^conn\\.(?!consul)/",
          "group": "inline@9"
        },
        {
          "command": "moonageDaydream.filterNode",
          "when": "view == moonageDaydream.explorer && viewItem =~ /^(conn\\.(?!consul)|db|folder\\.|ms\\.)/",
          "group": "0_filter@1"
        },
        {
          "command": "moonageDaydream.findObject",
          "when": "view == moonageDaydream.explorer && viewItem =~ /^(conn\\.(?!consul)|db)/",
          "group": "0_filter@2"
        },
        {
          "command": "moonageDaydream.selectTop",
          "when": "view == moonageDaydream.explorer && viewItem =~ /^(table|view)(\\.def)?(\\.ms)?(\\.trg)?(\\.cols)?$/",
          "group": "inline"
        },
        {
          "command": "moonageDaydream.runProcedure",
          "when": "view == moonageDaydream.explorer && viewItem =~ /^(procedure|function)\\.def(\\.ms)?$/",
          "group": "inline"
        },
        {
          "command": "moonageDaydream.runProcedure",
          "when": "view == moonageDaydream.explorer && viewItem =~ /^(procedure|function)\\.def(\\.ms)?$/",
          "group": "1_run@1"
        },
        {
          "command": "moonageDaydream.showDefinition",
          "when": "view == moonageDaydream.explorer && viewItem =~ /^(view|procedure|function|trigger)\\.def(\\.ms)?$/",
          "group": "2_script@1"
        },
        {
          "command": "moonageDaydream.editObject",
          "when": "view == moonageDaydream.explorer && viewItem =~ /^(view|procedure|function|trigger)\\.def(\\.ms)?$/",
          "group": "2_script@2"
